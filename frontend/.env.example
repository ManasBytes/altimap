# Public build-time configuration; never put tokens in VITE_* variables.
# Blank API base uses the local server / Vite proxy.
VITE_API_BASE=
# Use "disabled" for a hosted demo before the VM HTTPS endpoint is available.
# VITE_API_BASE=disabled
VITE_DEMO_CATALOG=https://huggingface.co/datasets/Dilavesh/altimap-demo/resolve/main/index.json
